# ============================================================
# BODHA — Root .gitignore
# ============================================================

# --- Java / Maven ---
backend/target/
target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# --- Node / Frontend ---
frontend/node_modules/
node_modules/
frontend/dist/
dist/
frontend/dist-ssr/
dist-ssr/
.nixpacks/

# --- Environment & Secrets (NEVER commit these) ---
.env
.env.*
!.env.example
!*.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example
*.env
*.env.local
*.env.*.local
*.secret
*.secrets
secrets/

# --- Private Keys & Certificates ---
*.pem
*.key
*.pkcs12
*.p12
*.pfx
id_rsa*
id_ed25519*

# --- Local Databases ---
*.db
*.sqlite
*.sqlite3

# --- Cloud / CLI State ---
.railway/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- OS Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.AppleDouble
.LSOverride

# --- IDE / Editor ---
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp

# --- Test output ---
backend/target/surefire-reports/
