# ============================================================
# BODHA — Root .gitignore
# ============================================================

# --- Java / Maven ---
backend/target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# --- Node / Frontend ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# --- Environment secrets (NEVER commit these) ---
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local
backend/.env
backend/.env.local
backend/.env.*.local
# .env.example files ARE committed (they contain placeholders only)

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride

# --- IDE / Editor ---
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Test output ---
backend/target/surefire-reports/
