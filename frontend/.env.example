# ============================================================
# BODHA Frontend — Environment Variables Example
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env — only commit .env.example
# ============================================================

# Backend API base URL (no trailing slash)
# Development: http://localhost:8080
# Production:  https://api.your-domain.com
VITE_API_BASE_URL=http://localhost:8080

# Demo access toggle
# false → REQUIRED FOR PRODUCTION (hides demo shortcuts and prefilled credentials)
# true  → development only
VITE_ENABLE_DEMO_ACCESS=false

