# ============================================================
# BODHA Backend — Environment Configuration Example (.env.example)
# Copy this file to .env or export these variables before running locally.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# ============================================================

# --- Server Configuration ---
PORT=8080
SPRING_PROFILES_ACTIVE=default

# --- Local PostgreSQL Database ---
# For local setup, create database: CREATE DATABASE bodha_db;
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bodha_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# --- JWT Authentication (HMAC-SHA256) ---
# In development, a fallback secret is available.
# In production ('prod' profile), a strong >=256-bit (>=32 char) key is mandatory.
JWT_SECRET=development-fallback-secret-key-must-be-at-least-256-bits-long-32-chars
JWT_EXPIRATION_MS=86400000

# --- CORS Allowed Origins ---
# Comma-separated list of origins. Wildcards (*) with credentials are forbidden.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- AI Personalization Engine ---
# AI_PROVIDER: 'mock' (deterministic offline provider) or 'gemini' (live Google AI Studio)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_ENDPOINT=https://generativelanguage.googleapis.com
AI_TIMEOUT_MS=5000
